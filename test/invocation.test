# -*- mode: python; coding: utf-8 -*-

t = Template(save_stdout=True,
             env={'LD_LIBRARY_PATH':'/usr/local/lib'})

s = Daemon('./server.py --Ice.Config=$dirname/config',
           desc='Servidor', template=[t])

conds = [FileExists('$dirname/config'),
         FileExists('/usr/local/lib/libIceTCPP.so.33')]

s.pre += conds
s.pre += Not(OpenPort(9999))
s.post += FileContains(s.stdout, 'Hola Mundo')

c = Test('./client.py --Ice.Config=$dirname/config',
         desc = 'Cliente', template=[t])
c.pre += [x.clone() for x in conds]
c.pre += Poll(TaskRunning(s))
c.post += FileContains(c.stdout, 'Mensaje enviado')

